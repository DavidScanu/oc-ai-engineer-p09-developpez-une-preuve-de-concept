{
  "name": "Python 3 - AI Project",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/main.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter"
      ]
    }
  },

  // S'exécute une seule fois après la création initiale du container
  "postCreateCommand": "bash setup.sh",

  // S'exécute à chaque fois qu'on se connecte au container
  "postAttachCommand": {
    "server": "bash start.sh"
  },

  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openPreview"
    }
  },
  
  "forwardPorts": [8501],
  
  "remoteUser": "vscode"
}